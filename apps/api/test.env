# Config for the integration suite. The config service requires a file named after
# NODE_ENV, and a committed one keeps the suite identical everywhere. The global setup
# sets DATABASE_PATH to a fresh temporary file per run.

NODE_ENV=test

WEB_APP_BASE_URL=http://localhost:8080

BLOCKED_AT_ENABLED=false

# No effect on access logs today - logger.module.ts leaves the root pino level at info.
LOG_STDOUT_LEVEL=error
LOG_STDOUT_PRETTY=false
LOG_FILE_LEVEL=error
LOG_FILE_PATH=

TYPEORM_LOGGING=false

# The global setup migrates before any app is created.
TYPEORM_MIGRATIONS_RUN=false

USE_TEST_MIGRATIONS=true

# The throttler is a global guard; the default would fail the suite, not the code.
RATE_LIMIT_MAX_REQUESTS=100000
