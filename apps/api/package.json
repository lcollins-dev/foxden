  "scripts": {
    "build": "rm -rf dist && nest build",
    "start": "npm run start:dev",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:clean": "bash scripts/db-clean.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "bash scripts/test-integration.sh",
    "code:lint": "eslint .",
    "code:lint:fix": "eslint . --fix",
    "code:format": "prettier --write .",
    "code:format:check": "prettier --check .",
    "code:typecheck": "tsc --noEmit -p tsconfig.integration.json",
    "npm:clean": "rm -rf node_modules"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/schedule": "6.1.0",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.0",
    "better-sqlite3": "12.11.1",
    "blocked-at": "1.2.0",
    "handlebars": "4.7.10",
    "helmet": "8.1.0",
    "ipaddr.js": "1.9.1",
    "jose": "6.2.12",
    "juice": "11.1.1",
    "lodash": "4.18.1",
    "module-alias": "2.2.3",
    "moment": "2.31.0",
    "ms": "2.1.3",
    "nestjs-pino": "4.5.0",
    "nodemailer": "10.0.9",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rotating-file-stream": "3.2.1",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "typeorm-transactional": "0.5.0",
    "uuid": "13.0.1",
    "validator": "13.15.26",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.6",
    "@swc/core": "1.15.33",
    "@types/better-sqlite3": "7.6.13",
    "@types/blocked-at": "1.0.4",
    "@types/express": "5.0.6",
    "@types/lodash": "4.17.21",
    "@types/ms": "2.1.0",
    "@types/node": "22.17.2",
    "@types/supertest": "7.2.1",
