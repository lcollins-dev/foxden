{
  "name": "e2e",
  "version": "0.0.0",
  "private": true,
  "author": "Louis Collins",
  "license": "AGPL-3.0-only",
  "description": "End-to-end tests for Foxden",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "codegen": "playwright codegen $E2E_BASE_URL",
    "install-browsers": "playwright install chromium",
    "screenshots": "playwright test -c screenshots/playwright.config.ts",
    "code:lint": "eslint .",
    "code:lint:fix": "eslint . --fix",
    "code:format": "prettier --write .",
    "code:format:check": "prettier --check .",
    "code:typecheck": "tsc --noEmit",
    "npm:clean": "rm -rf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.17.2",
    "better-sqlite3": "12.11.1",
    "typescript": "5.9.3"
  }
}
