# The origin Firefox and browsers reach the server on, behind the TLS-terminating proxy.
WEB_APP_BASE_URL=http://localhost:3000

# Leave EMAIL_SMTP_HOST blank to turn email off. Leave EMAIL_SMTP_USERNAME blank for a relay that takes mail without
# signing in. DEPLOYMENT.md in the repository covers the port and TLS settings.
EMAIL_SMTP_HOST=
EMAIL_FROM_ADDRESS=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
